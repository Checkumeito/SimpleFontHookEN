static const PickerGuideSectionData& CurrentPickerGuideSection() {
    int index = max(0, min(PICKER_GUIDE_SECTION_COUNT - 1,
        (int)g_guideSection));
    return g_pickerGuideSections[index];
}

struct PickerGuideTextLine {
    const wchar_t* text;
    int length;
};

static bool IsPickerGuideAsciiWordChar(wchar_t ch) {
    return (ch >= L'0' && ch <= L'9') ||
        (ch >= L'A' && ch <= L'Z') ||
        (ch >= L'a' && ch <= L'z') ||
        ch == L'_' || ch == L'-' || ch == L'+' || ch == L'/' ||
        ch == L'\\' || ch == L'.' || ch == L':' || ch == L'=';
}

static bool IsPickerGuideInlineSpace(wchar_t ch) {
    return ch == L' ' || ch == L'\t';
}

static void BuildPickerGuideTextLines(HDC hdc, const wchar_t* text,
    int width, std::vector<PickerGuideTextLine>& lines) {
    lines.clear();
    if (!text || !text[0]) return;

    const int textLength = (int)wcslen(text);
    int position = 0;
    while (position < textLength) {
        if (text[position] == L'\r' || text[position] == L'\n') {
            lines.push_back({ text + position, 0 });
            if (text[position] == L'\r' && position + 1 < textLength &&
                text[position + 1] == L'\n') {
                ++position;
            }
            ++position;
            continue;
        }

        int paragraphEnd = position;
        while (paragraphEnd < textLength && text[paragraphEnd] != L'\r' &&
            text[paragraphEnd] != L'\n') {
            ++paragraphEnd;
        }

        while (position < paragraphEnd) {
            while (position < paragraphEnd &&
                IsPickerGuideInlineSpace(text[position])) {
                ++position;
            }
            if (position >= paragraphEnd) break;

            const int remaining = paragraphEnd - position;
            int fit = 0;
            SIZE extent = {};
            GetTextExtentExPointW(hdc, text + position, remaining,
                max(1, width), &fit, NULL, &extent);
            fit = max(1, min(fit, remaining));

            int take = fit;
            if (fit < remaining &&
                IsPickerGuideAsciiWordChar(text[position + fit - 1]) &&
                IsPickerGuideAsciiWordChar(text[position + fit])) {
                int wordStart = fit;
                while (wordStart > 0 &&
                    IsPickerGuideAsciiWordChar(text[position + wordStart - 1])) {
                    --wordStart;
                }
                if (wordStart > 0) take = wordStart;
            }

            int visibleLength = take;
            while (visibleLength > 0 &&
                IsPickerGuideInlineSpace(text[position + visibleLength - 1])) {
                --visibleLength;
            }
            if (visibleLength == 0) visibleLength = take;
            lines.push_back({ text + position, visibleLength });
            position += take;
        }

        if (position < textLength && text[position] == L'\r') ++position;
        if (position < textLength && text[position] == L'\n') ++position;
    }
}

static int GetPickerGuideTextLineHeight(HDC hdc) {
    TEXTMETRICW metrics = {};
    if (!GetTextMetricsW(hdc, &metrics)) return max(1, SF(11));
    return max(1, (int)metrics.tmHeight);
}

static int GetPickerGuideTextLineGap(HDC hdc) {
    TEXTMETRICW metrics = {};
    GetTextMetricsW(hdc, &metrics);
    return max(max(2, SF(3)), (int)metrics.tmExternalLeading);
}

static int MeasurePickerGuideText(HDC hdc, HFONT font,
    const wchar_t* text, int width, UINT format) {
    if (!text || !text[0]) return 0;
    HGDIOBJ oldFont = SelectObject(hdc, font);

    int height = 0;
    if ((format & DT_WORDBREAK) != 0 && (format & DT_SINGLELINE) == 0) {
        std::vector<PickerGuideTextLine> lines;
        BuildPickerGuideTextLines(hdc, text, width, lines);
        const int lineHeight = GetPickerGuideTextLineHeight(hdc);
        const int lineGap = GetPickerGuideTextLineGap(hdc);
        if (!lines.empty()) {
            height = (int)lines.size() * lineHeight +
                ((int)lines.size() - 1) * lineGap;
        }
    }
    else {
        RECT calc = { 0, 0, max(1, width), 0 };
        DrawTextW(hdc, text, -1, &calc,
            format | DT_CALCRECT | DT_NOPREFIX);
        height = (int)(calc.bottom - calc.top);
    }

    SelectObject(hdc, oldFont);
    return max(1, height);
}

static void DrawPickerGuideText(HDC hdc, HFONT font,
    COLORREF color, const wchar_t* text, RECT rect, UINT format) {
    HGDIOBJ oldFont = SelectObject(hdc, font);
    SetTextColor(hdc, color);

    if (text && text[0] && (format & DT_WORDBREAK) != 0 &&
        (format & DT_SINGLELINE) == 0) {
        std::vector<PickerGuideTextLine> lines;
        BuildPickerGuideTextLines(hdc, text, rect.right - rect.left, lines);
        const int lineHeight = GetPickerGuideTextLineHeight(hdc);
        const int lineGap = GetPickerGuideTextLineGap(hdc);
        int lineTop = rect.top;
        for (const PickerGuideTextLine& line : lines) {
            RECT lineRect = { rect.left, lineTop, rect.right,
                lineTop + lineHeight };
            if (line.length > 0) {
                DrawTextW(hdc, line.text, line.length, &lineRect,
                    DT_LEFT | DT_SINGLELINE | DT_NOPREFIX);
            }
            lineTop += lineHeight + lineGap;
        }
    }
    else {
        DrawTextW(hdc, text, -1, &rect, format | DT_NOPREFIX);
    }

    SelectObject(hdc, oldFont);
}

static int LayoutPickerGuideContent(HDC hdc,
    const PickerGuideSectionData& section, int left, int right,
    int startY, bool draw) {
    int width = max(1, right - left);
    int y = startY;

    HFONT pageTitleFont = GetCachedPickerFont(L"Segoe UI", SF(18), 0,
        FW_BOLD, DEFAULT_CHARSET);
    HFONT pageSummaryFont = GetCachedPickerFont(L"Segoe UI", SF(11), 0,
        FW_NORMAL, DEFAULT_CHARSET);
    HFONT headingFont = GetCachedPickerFont(L"Segoe UI", SF(13), 0,
        FW_BOLD, DEFAULT_CHARSET);
    HFONT labelFont = GetCachedPickerFont(L"Segoe UI", SF(11), 0,
        FW_BOLD, DEFAULT_CHARSET);
    HFONT bodyFont = GetCachedPickerFont(L"Segoe UI", SF(11), 0,
        FW_NORMAL, DEFAULT_CHARSET);
    HFONT keyFont = GetCachedPickerFont(L"Consolas", SF(10), 0,
        FW_BOLD, DEFAULT_CHARSET);

    int titleHeight = MeasurePickerGuideText(hdc, pageTitleFont,
        section.title, width, DT_LEFT | DT_WORDBREAK);
    if (draw) {
        RECT titleRect = { left, y, right, y + titleHeight };
        DrawPickerGuideText(hdc, pageTitleFont, COL_TEXT,
            section.title, titleRect, DT_LEFT | DT_WORDBREAK);
    }
    y += titleHeight + max(4, SF(5));

    int summaryHeight = MeasurePickerGuideText(hdc, pageSummaryFont,
        section.summary, width, DT_LEFT | DT_WORDBREAK);
    if (draw) {
        RECT summaryRect = { left, y, right, y + summaryHeight };
        DrawPickerGuideText(hdc, pageSummaryFont, COL_TEXT_DIM,
            section.summary, summaryRect, DT_LEFT | DT_WORDBREAK);
    }
    y += summaryHeight + max(12, SF(16));

    if (draw) {
        HPEN separator = CreatePen(PS_SOLID, 1, COL_BORDER);
        HGDIOBJ oldPen = SelectObject(hdc, separator);
        MoveToEx(hdc, left, y - 1, NULL);
        LineTo(hdc, right, y - 1);
        SelectObject(hdc, oldPen);
        DeleteObject(separator);
    }

    int itemIndex = 0;
    for (int blockIndex = 0; blockIndex < section.blockCount; ++blockIndex) {
        const PickerGuideBlock& block = section.blocks[blockIndex];
        if (block.kind == PICKER_GUIDE_BLOCK_HEADING) {
            y += blockIndex == 0 ? max(8, SF(10)) : max(18, SF(22));
            int headingHeight = MeasurePickerGuideText(hdc, headingFont,
                block.label, width - 14, DT_LEFT | DT_WORDBREAK);
            if (draw) {
                RECT accentRect = { left, y + 1, left + 4,
                    y + max(headingHeight, SF(18)) };
                HBRUSH accentBrush = CreateSolidBrush(COL_ACCENT);
                FillRect(hdc, &accentRect, accentBrush);
                DeleteObject(accentBrush);
                RECT headingRect = { left + 14, y, right,
                    y + headingHeight };
                DrawPickerGuideText(hdc, headingFont, COL_TEXT,
                    block.label, headingRect, DT_LEFT | DT_WORDBREAK);
            }
            y += headingHeight + max(8, SF(10));
            continue;
        }

        if (block.kind == PICKER_GUIDE_BLOCK_PARAGRAPH) {
            int textHeight = MeasurePickerGuideText(hdc, bodyFont,
                block.text, width, DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            if (draw) {
                RECT textRect = { left, y, right, y + textHeight };
                DrawPickerGuideText(hdc, bodyFont, COL_TEXT_DIM,
                    block.text, textRect,
                    DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            }
            y += textHeight + max(10, SF(12));
            continue;
        }

        if (block.kind == PICKER_GUIDE_BLOCK_STEP) {
            int markerSize = max(24, SF(26));
            int textLeft = left + markerSize + 12;
            int textHeight = MeasurePickerGuideText(hdc, bodyFont,
                block.text, right - textLeft,
                DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            int blockHeight = max(markerSize, textHeight);
            if (draw) {
                RECT markerRect = { left, y, left + markerSize,
                    y + markerSize };
                COLORREF markerColor = itemIndex % 2 == 0
                    ? COL_ACCENT2 : RGB(125, 220, 180);
                HBRUSH markerBrush = CreateSolidBrush(
                    MixColor(markerColor, RGB(20, 18, 34), 0.58f));
                HPEN markerPen = CreatePen(PS_SOLID, 1, markerColor);
                HGDIOBJ oldBrush = SelectObject(hdc, markerBrush);
                HGDIOBJ oldPen = SelectObject(hdc, markerPen);
                Ellipse(hdc, markerRect.left, markerRect.top,
                    markerRect.right, markerRect.bottom);
                SelectObject(hdc, oldPen);
                SelectObject(hdc, oldBrush);
                DeleteObject(markerPen);
                DeleteObject(markerBrush);
                DrawPickerGuideText(hdc, labelFont, markerColor,
                    block.label, markerRect,
                    DT_CENTER | DT_VCENTER | DT_SINGLELINE);
                RECT textRect = { textLeft, y, right, y + textHeight };
                DrawPickerGuideText(hdc, bodyFont, COL_TEXT_DIM,
                    block.text, textRect,
                    DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            }
            y += blockHeight + max(12, SF(14));
            ++itemIndex;
            continue;
        }

        if (block.kind == PICKER_GUIDE_BLOCK_ITEM) {
            int textLeft = left + 18;
            int labelHeight = MeasurePickerGuideText(hdc, labelFont,
                block.label, right - textLeft, DT_LEFT | DT_WORDBREAK);
            int bodyHeight = MeasurePickerGuideText(hdc, bodyFont,
                block.text, right - textLeft,
                DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            if (draw) {
                COLORREF bulletColor = itemIndex % 3 == 0 ? COL_ACCENT2
                    : itemIndex % 3 == 1 ? RGB(125, 220, 180)
                    : RGB(245, 195, 105);
                HBRUSH bulletBrush = CreateSolidBrush(bulletColor);
                HPEN bulletPen = CreatePen(PS_SOLID, 1, bulletColor);
                HGDIOBJ oldBrush = SelectObject(hdc, bulletBrush);
                HGDIOBJ oldPen = SelectObject(hdc, bulletPen);
                Ellipse(hdc, left + 2, y + max(4, SF(5)),
                    left + 8, y + max(10, SF(11)));
                SelectObject(hdc, oldPen);
                SelectObject(hdc, oldBrush);
                DeleteObject(bulletPen);
                DeleteObject(bulletBrush);
                RECT labelRect = { textLeft, y, right, y + labelHeight };
                DrawPickerGuideText(hdc, labelFont, COL_TEXT,
                    block.label, labelRect, DT_LEFT | DT_WORDBREAK);
                RECT bodyRect = { textLeft, y + labelHeight + 3, right,
                    y + labelHeight + 3 + bodyHeight };
                DrawPickerGuideText(hdc, bodyFont, COL_TEXT_DIM,
                    block.text, bodyRect,
                    DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            }
            y += labelHeight + 3 + bodyHeight + max(12, SF(14));
            ++itemIndex;
            continue;
        }

        if (block.kind == PICKER_GUIDE_BLOCK_NOTE) {
            int innerLeft = left + 13;
            int innerRight = right - 10;
            int labelHeight = MeasurePickerGuideText(hdc, labelFont,
                block.label, innerRight - innerLeft,
                DT_LEFT | DT_WORDBREAK);
            int bodyHeight = MeasurePickerGuideText(hdc, bodyFont,
                block.text, innerRight - innerLeft,
                DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            int padding = max(10, SF(11));
            int blockHeight = padding + labelHeight + 4 + bodyHeight + padding;
            if (draw) {
                RECT noteRect = { left, y, right, y + blockHeight };
                HBRUSH noteBrush = CreateSolidBrush(RGB(30, 36, 48));
                FillRect(hdc, &noteRect, noteBrush);
                DeleteObject(noteBrush);
                RECT noteAccent = { left, y, left + 4, y + blockHeight };
                HBRUSH noteAccentBrush = CreateSolidBrush(RGB(125, 220, 180));
                FillRect(hdc, &noteAccent, noteAccentBrush);
                DeleteObject(noteAccentBrush);
                RECT labelRect = { innerLeft, y + padding, innerRight,
                    y + padding + labelHeight };
                DrawPickerGuideText(hdc, labelFont, RGB(150, 235, 195),
                    block.label, labelRect, DT_LEFT | DT_WORDBREAK);
                RECT bodyRect = { innerLeft, labelRect.bottom + 4,
                    innerRight, labelRect.bottom + 4 + bodyHeight };
                DrawPickerGuideText(hdc, bodyFont, COL_TEXT_DIM,
                    block.text, bodyRect,
                    DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            }
            y += blockHeight + max(12, SF(14));
            continue;
        }

        if (block.kind == PICKER_GUIDE_BLOCK_KEY ||
            block.kind == PICKER_GUIDE_BLOCK_REGISTERED_HOTKEY) {
            const wchar_t* keyLabel = block.kind == PICKER_GUIDE_BLOCK_REGISTERED_HOTKEY
                ? g_toggleHotkeyDisplayName : block.label;
            int keyWidth = min(max(104, SF(116)), max(104, width * 42 / 100));
            int descLeft = left + keyWidth + 12;
            int keyHeight = MeasurePickerGuideText(hdc, keyFont,
                keyLabel, keyWidth, DT_LEFT | DT_WORDBREAK);
            int descHeight = MeasurePickerGuideText(hdc, bodyFont,
                block.text, right - descLeft,
                DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
            int rowHeight = max(keyHeight, descHeight) + max(14, SF(16));
            if (draw) {
                RECT keyRect = { left, y + 2, left + keyWidth,
                    y + 2 + keyHeight };
                DrawPickerGuideText(hdc, keyFont, COL_ACCENT2,
                    keyLabel, keyRect, DT_LEFT | DT_WORDBREAK);
                RECT descRect = { descLeft, y + 2, right,
                    y + 2 + descHeight };
                DrawPickerGuideText(hdc, bodyFont, COL_TEXT_DIM,
                    block.text, descRect,
                    DT_LEFT | DT_WORDBREAK | DT_EDITCONTROL);
                HPEN rowLine = CreatePen(PS_SOLID, 1, COL_SEPARATOR);
                HGDIOBJ oldPen = SelectObject(hdc, rowLine);
                MoveToEx(hdc, left, y + rowHeight - 1, NULL);
                LineTo(hdc, right, y + rowHeight - 1);
                SelectObject(hdc, oldPen);
                DeleteObject(rowLine);
            }
            y += rowHeight;
        }
    }

    return y - startY;
}

static void PaintGuidePage(HDC mem, const RECT& rc)
{
    RECT pageRect = { 0, TITLE_HEIGHT, rc.right, rc.bottom };
    HBRUSH pageBrush = CreateSolidBrush(RGB(17, 16, 31));
    FillRect(mem, &pageRect, pageBrush);
    DeleteObject(pageBrush);

    RECT headerRect = GetGuideHeaderRect();
    GradientV(mem, headerRect, RGB(40, 31, 58), RGB(24, 22, 42));
    RECT headerAccent = { 18, headerRect.top + 14, 22,
        headerRect.bottom - 14 };
    HBRUSH headerAccentBrush = CreateSolidBrush(COL_ACCENT);
    FillRect(mem, &headerAccent, headerAccentBrush);
    DeleteObject(headerAccentBrush);

    HFONT headerFont = GetCachedPickerFont(L"Segoe UI", min(SF(18), 22), 0,
        FW_BOLD, DEFAULT_CHARSET);
    HFONT headerSummaryFont = GetCachedPickerFont(L"Segoe UI", min(SF(10), 13), 0,
        FW_NORMAL, DEFAULT_CHARSET);
    RECT headerTitleRect = { 34, headerRect.top + 8,
        rc.right - 70, headerRect.top + 34 };
    DrawPickerGuideText(mem, headerFont, COL_TEXT, L"User Guide",
        headerTitleRect, DT_LEFT | DT_VCENTER | DT_SINGLELINE);
    RECT headerSummaryRect = { 34, headerRect.top + 34,
        rc.right - 18, headerRect.bottom - 5 };
    DrawPickerGuideText(mem, headerSummaryFont, COL_TEXT_DIM,
        L"Complete instructions for everyday use",
        headerSummaryRect, DT_LEFT | DT_VCENTER | DT_SINGLELINE |
        DT_END_ELLIPSIS);
    wchar_t sectionCounter[16] = {};
    swprintf_s(sectionCounter, L"%d / %d", (int)g_guideSection + 1,
        PICKER_GUIDE_SECTION_COUNT);
    RECT counterRect = { rc.right - 68, headerRect.top + 8,
        rc.right - 18, headerRect.top + 34 };
    DrawPickerGuideText(mem, headerSummaryFont, COL_TEXT_HINT,
        sectionCounter, counterRect,
        DT_RIGHT | DT_VCENTER | DT_SINGLELINE);

    RECT tabsRect = GetGuideSectionTabsRect();
    HBRUSH tabsBrush = CreateSolidBrush(RGB(22, 20, 39));
    FillRect(mem, &tabsRect, tabsBrush);
    DeleteObject(tabsBrush);
    HFONT tabFont = GetCachedPickerFont(L"Segoe UI", min(SF(10), 13), 0,
        FW_BOLD, DEFAULT_CHARSET);
    for (int index = 0; index < PICKER_GUIDE_SECTION_COUNT; ++index) {
        RECT tabRect = GetGuideSectionTabRect(index);
        bool active = index == (int)g_guideSection;
        bool hovered = index == g_guideHoveredSection;
        COLORREF fill = active ? RGB(86, 44, 80) : RGB(35, 29, 52);
        if (hovered) fill = active ? RGB(108, 54, 96) : COL_BTN_HOV;
        FillRoundRect(mem, tabRect, 8, fill);
        DrawRoundRectOutline(mem, tabRect, 8,
            active ? COL_ACCENT : COL_BORDER);
        DrawPickerGuideText(mem, tabFont,
            active ? COL_TEXT : COL_TEXT_DIM,
            g_pickerGuideSections[index].tabLabel, tabRect,
            DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS);
    }

    RECT viewport = GetGuideViewportRect();
    const PickerGuideSectionData& section = CurrentPickerGuideSection();
    int contentLeft = 20;
    int contentRight = max(contentLeft + 40, (int)rc.right - 24);
    int contentPadding = max(14, SF(18));
    int measuredHeight = LayoutPickerGuideContent(mem, section,
        contentLeft, contentRight, 0, false) + contentPadding * 2;
    g_guideContentHeight = measuredHeight;
    int maxScroll = max(0, measuredHeight -
        (int)(viewport.bottom - viewport.top));
    g_guideScrollOffset = max(0, min(maxScroll, g_guideScrollOffset));

    int savedDc = SaveDC(mem);
    IntersectClipRect(mem, viewport.left, viewport.top,
        viewport.right, viewport.bottom);
    int contentTop = viewport.top + contentPadding - g_guideScrollOffset;
    LayoutPickerGuideContent(mem, section, contentLeft, contentRight,
        contentTop, true);
    RestoreDC(mem, savedDc);

    RECT thumb = {}, track = {};
    GetGuideScrollbarRect(&thumb, &track);
    if (GetGuideMaxScroll() > 0) {
        FillRoundRect(mem, track, 6, COL_SB_TRACK);
        COLORREF thumbColor = g_guideScrollbarDragging ? COL_SB_THUMB_DRG
            : g_guideScrollbarHovered ? COL_SB_THUMB_HOV : COL_SB_THUMB;
        FillRoundRect(mem, thumb, 6, thumbColor);
    }

    RECT footerRect = GetGuideFooterRect();
    HBRUSH footerBrush = CreateSolidBrush(RGB(23, 21, 40));
    FillRect(mem, &footerRect, footerBrush);
    DeleteObject(footerBrush);
    HPEN footerLine = CreatePen(PS_SOLID, 1, COL_BORDER);
    HGDIOBJ oldFooterLine = SelectObject(mem, footerLine);
    MoveToEx(mem, 0, footerRect.top, NULL);
    LineTo(mem, rc.right, footerRect.top);
    SelectObject(mem, oldFooterLine);
    DeleteObject(footerLine);

    wchar_t footerText[160] = {};
    swprintf_s(footerText,
        L"Wheel: Scroll  ·  Tab: Fonts  ·  Esc: Hide  ·  Hotkey: %s",
        g_toggleHotkeyDisplayName);
    HFONT footerFont = GetCachedPickerFont(L"Segoe UI", min(SF(10), 12), 0,
        FW_NORMAL, DEFAULT_CHARSET);
    RECT footerTextRect = { 12, footerRect.top,
        rc.right - 12, footerRect.bottom };
    DrawPickerGuideText(mem, footerFont, COL_TEXT_HINT, footerText,
        footerTextRect,
        DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS);
}
