enum PickerGuideBlockKind {
    PICKER_GUIDE_BLOCK_HEADING = 0,
    PICKER_GUIDE_BLOCK_PARAGRAPH,
    PICKER_GUIDE_BLOCK_STEP,
    PICKER_GUIDE_BLOCK_ITEM,
    PICKER_GUIDE_BLOCK_NOTE,
    PICKER_GUIDE_BLOCK_KEY,
    PICKER_GUIDE_BLOCK_REGISTERED_HOTKEY,
};

struct PickerGuideBlock {
    PickerGuideBlockKind kind;
    const wchar_t* label;
    const wchar_t* text;
};

struct PickerGuideSectionData {
    const wchar_t* tabLabel;
    const wchar_t* title;
    const wchar_t* summary;
    const PickerGuideBlock* blocks;
    int blockCount;
};

static const PickerGuideBlock g_quickStartGuideBlocks[] = {
    { PICKER_GUIDE_BLOCK_HEADING, L"Prepare the files", NULL },
    { PICKER_GUIDE_BLOCK_STEP, L"1",
      L"Check the architecture of the executable that actually runs the game. Use the Win32 winmm.dll for a 32-bit game, or the x64 winmm.dll for a 64-bit game." },
    { PICKER_GUIDE_BLOCK_STEP, L"2",
      L"Back up any existing winmm.dll and FontHook.ini in the game directory. Keep the original files available for restoration." },
    { PICKER_GUIDE_BLOCK_STEP, L"3",
      L"Place the matching winmm.dll beside the .exe that actually runs the game, then launch the game." },
    { PICKER_GUIDE_BLOCK_NOTE, L"Check that it loaded",
      L"If the font picker appears after launch, the tool has loaded into that process. The footer shows the window hotkey that was successfully registered." },

    { PICKER_GUIDE_BLOCK_HEADING, L"Apply your first font", NULL },
    { PICKER_GUIDE_BLOCK_STEP, L"1",
      L"Choose the charset matching the actual encoding of the game text. Search for a font by name, or browse the list with the mouse wheel." },
    { PICKER_GUIDE_BLOCK_NOTE, L"Encoding and charset options",
      L"Choose Japanese for Shift-JIS / CP932, Chinese for GBK / GB2312 / CP936, Traditional for Big5 / CP950, or Korean for CP949. Check the game version or text patch documentation; do not infer encoding from the interface language." },
    { PICKER_GUIDE_BLOCK_STEP, L"2",
      L"Click a font to see its appearance in the list and preview. This only previews the font; double-click it or press Enter to apply it." },
    { PICKER_GUIDE_BLOCK_STEP, L"3",
      L"After applying, return to the game and check menus, dialogue, punctuation, numbers, line breaks, and long text. Confirm that the font changed and all text remains intact." },
    { PICKER_GUIDE_BLOCK_STEP, L"4",
      L"If text displays correctly, leave Spoof, Map, and CP off. When a specific problem occurs, consult Features and adjust the corresponding setting." },
    { PICKER_GUIDE_BLOCK_NOTE, L"Automatic saving",
      L"Font applications, toggle changes, and layout values are saved automatically to FontHook.ini beside the DLL. There is no separate Save button." },
    { PICKER_GUIDE_BLOCK_NOTE, L"Recommended order",
      L"Change one type of setting at a time and check the result in the game before continuing. This makes it easier to identify what helped and restore earlier settings." },
};

