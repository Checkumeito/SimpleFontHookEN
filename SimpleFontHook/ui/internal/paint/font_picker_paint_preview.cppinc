static void PaintPreviewPanel(HDC mem, const RECT& rc)
{
    // Preview panel.
    int prevTop = GetPreviewTop();
    RECT prevBg = { 0, prevTop, rc.right, rc.bottom };
    GradientV(mem, prevBg, COL_PREVIEW_TOP, COL_PREVIEW_BOT);

    // Dialogue box style border
    {
        RECT boxRc = { 10, prevTop + 10, rc.right - 10, rc.bottom - 10 };
        DrawRoundRectOutline(mem, boxRc, 12, COL_BORDER);
        // Inner thin line for dialogue box feel
        RECT innerRc = { 12, prevTop + 12, rc.right - 12, rc.bottom - 12 };
        DrawRoundRectOutline(mem, innerRc, 10, MixColor(COL_BORDER, COL_ACCENT, 0.2f));
    }

    // Top border + accent line
    {
        HPEN bp = CreatePen(PS_SOLID, 1, COL_BORDER);
        HGDIOBJ op = SelectObject(mem, bp);
        MoveToEx(mem, 0, prevTop, NULL); LineTo(mem, rc.right, prevTop);
        SelectObject(mem, op); DeleteObject(bp);
    }
    {
        HPEN ap = CreatePen(PS_SOLID, 1, MixColor(COL_ACCENT, COL_PREVIEW_TOP, 0.6f));
        HGDIOBJ op = SelectObject(mem, ap);
        MoveToEx(mem, 0, prevTop + 1, NULL); LineTo(mem, rc.right, prevTop + 1);
        SelectObject(mem, op); DeleteObject(ap);
    }

    // Decorative sparkle in preview corner
    DrawSparkle(mem, rc.right - 24, prevTop + 14, 3, MixColor(COL_ACCENT2, COL_PREVIEW_TOP, 0.5f));
    DrawPetal(mem, rc.right - 42, prevTop + 20, 3, 4, MixColor(COL_ACCENT, COL_PREVIEW_TOP, 0.6f));
    DrawPetal(mem, 24, rc.bottom - 20, 4, 5, COL_ACCENT3);

    BYTE gameCs = GetGameCharset();
    int itemCount = (int)g_filteredIndices.size();
    if (g_selectedIndex >= 0 && g_selectedIndex < itemCount) {
        const std::wstring& fontName = g_allFonts[g_filteredIndices[g_selectedIndex]].name;

        // Full preview text
        // The panel is a bounded visual sample, even when an existing INI carries
        // unusually large metrics. Leave the actual game configuration untouched.
        float requestedHeight = (float)SF(28);
        if (Config::EnableFontHeightScale)
            requestedHeight *= Config::FontHeightScale;
        int previewHeight = (int)max((float)SF(12), min(96.0f, requestedHeight));
        int previewWidth = 0;
        if (Config::EnableFontWidthScale)
            previewWidth = (int)max(1.0f, min(96.0f, (previewHeight / 2.0f) * Config::FontWidthScale));
        int previewWeight = Config::EnableFontWeight ? Config::FontWeight : FW_NORMAL;
        const wchar_t* previewLines[] = {
            L"Sample Text",
            L"0123456789 !?"
        };
        RECT contentRc = { 24, prevTop + 20, rc.right - 24, rc.bottom - 55 };
        int savedPreview = SaveDC(mem);
        int previewLineStep = 1;
        // Scale the visual sample as a whole to fit the compact panel. This does
        // not write any font metrics or spacing back to the game configuration.
        for (int height = previewHeight; height >= 1; --height) {
            float fit = (float)height / max(1, previewHeight);
            int width = previewWidth ? max(1, (int)(previewWidth * fit)) : 0;
            SelectObject(mem, GetCachedPickerFont(fontName, height, width, previewWeight, gameCs));
            int spacing = Config::EnableFontCharSpacing ? ClampInt(Config::FontCharSpacing, -20, 60) : 0;
            SetTextCharacterExtra(mem, (int)(spacing * fit));
            TEXTMETRICW metrics = {};
            GetTextMetricsW(mem, &metrics);
            previewLineStep = max(1, (int)(metrics.tmHeight + metrics.tmExternalLeading));
            if (Config::EnableFontLineSpacing)
                previewLineStep = max((int)metrics.tmHeight, (int)metrics.tmHeight +
                    (int)(ClampInt(Config::FontLineSpacing, -80, 200) * fit));
            SIZE first = {}, second = {};
            GetTextExtentPoint32W(mem, previewLines[0], lstrlenW(previewLines[0]), &first);
            GetTextExtentPoint32W(mem, previewLines[1], lstrlenW(previewLines[1]), &second);
            if (max(first.cx, second.cx) <= contentRc.right - contentRc.left &&
                previewLineStep + metrics.tmHeight <= contentRc.bottom - contentRc.top) break;
        }
        SetTextColor(mem, COL_TEXT);
        IntersectClipRect(mem, contentRc.left, contentRc.top, contentRc.right, contentRc.bottom);
        int lineY = contentRc.top;
        for (int i = 0; i < 2 && lineY < contentRc.bottom; ++i) {
            TextOutW(mem, contentRc.left, lineY, previewLines[i], lstrlenW(previewLines[i]));
            lineY += previewLineStep;
        }
        RestoreDC(mem, savedPreview);

        // Bottom info line
        HFONT infoFont = GetCachedPickerFont(L"Segoe UI", SF(11), 0, FW_NORMAL, DEFAULT_CHARSET);
        HGDIOBJ oldInfoFont = SelectObject(mem, infoFont);

        SetTextColor(mem, COL_TEXT_DIM);
        RECT infoRc = { 18, rc.bottom - 49, rc.right - 18, rc.bottom - 32 };
        wchar_t infoBuf[256];
        
        // Map detected charset to name
        const wchar_t* detName = L"Unknown"; // Unknown
        for(int i=0; i<g_charsetCount; i++) {
            if(g_charsets[i].value == Config::DetectedCharset) {
                detName = g_charsets[i].label;
                break;
            }
        }

        wsprintfW(infoBuf, L"Game: %s (%d)  |  Selected: %s (%d)  |  %d/%d",
            detName, (int)Config::DetectedCharset,
            g_charsets[g_selectedCharset].label, (int)g_charsets[g_selectedCharset].value,
            g_selectedIndex + 1, itemCount); // Game: ... | Selected: ...
        SelectObject(mem, GetFittedPickerFont(mem, infoBuf, infoRc, SF(11)));
        DrawTextW(mem, infoBuf, -1, &infoRc, DT_LEFT | DT_VCENTER | DT_SINGLELINE);

        RECT hintRc = { 18, rc.bottom - 32, rc.right - 18, rc.bottom - 15 };
        wchar_t hintBuf[96] = {};
        swprintf_s(hintBuf, L"Enter=Apply  Esc=Hide  Hotkey=%s", g_toggleHotkeyDisplayName);
        SelectObject(mem, GetFittedPickerFont(mem, hintBuf, hintRc, SF(11)));
        SetTextColor(mem, COL_TEXT_DIM);
        DrawTextW(mem, hintBuf, -1, &hintRc, DT_RIGHT | DT_VCENTER | DT_SINGLELINE);
        SelectObject(mem, oldInfoFont);
    }

}
