static void PaintTextSubstitutionBar(HDC mem, const RECT& rc)
{
    int top = GetTextSubTop();
    RECT bg = { 0, top, rc.right, top + TEXTSUB_HEIGHT };
    HBRUSH bgBr = CreateSolidBrush(RGB(18, 18, 36));
    FillRect(mem, &bg, bgBr);
    DeleteObject(bgBr);

    HPEN sep = CreatePen(PS_SOLID, 1, COL_SEPARATOR);
    HGDIOBJ oldSep = SelectObject(mem, sep);
    MoveToEx(mem, 0, top + TEXTSUB_HEIGHT - 1, NULL);
    LineTo(mem, rc.right, top + TEXTSUB_HEIGHT - 1);
    SelectObject(mem, oldSep);
    DeleteObject(sep);

    PickerButtonRow row = GetMappingButtonRow(mem);
    const bool active[] = { g_textSubstitutionEnabled, g_textSubstitutionEnabled,
        g_codepageRedirectEnabled, g_codepageRedirectEnabled };
    const bool hovered[] = { g_textSubstitutionHovered, g_textSubstitutionModeHovered,
        g_codepageRedirectHovered, g_codepageRedirectPresetHovered };
    HGDIOBJ oldFont = GetCurrentObject(mem, OBJ_FONT);
    for (int i = 0; i < row.count; ++i) {
        RECT button = row.rects[i];
        COLORREF fill = active[i] ? RGB(40, 70, 85) : RGB(50, 35, 65);
        if (hovered[i]) fill = active[i] ? RGB(50, 90, 105) : RGB(65, 48, 85);
        FillRoundRect(mem, button, 10, fill);
        DrawRoundRectOutline(mem, button, 10, active[i] ? RGB(130, 210, 255) : COL_BORDER);
        SetTextColor(mem, active[i] ? RGB(170, 230, 255) : COL_TEXT_DIM);
        SelectObject(mem, row.fonts[i]);
        DrawTextW(mem, row.labels[i], -1, &button, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
    }

    SelectObject(mem, oldFont);
}
